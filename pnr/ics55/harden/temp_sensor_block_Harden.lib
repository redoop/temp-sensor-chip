library (temp_sensor_block) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1nW;
  current_unit                   : "1mA";
  pulling_resistance_unit        : "1kohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1V";
  library_features(report_delay_calculation);
  input_threshold_pct_rise       : 50;
  input_threshold_pct_fall       : 50;
  output_threshold_pct_rise      : 50;
  output_threshold_pct_fall      : 50;
  slew_lower_threshold_pct_rise  : 30;
  slew_lower_threshold_pct_fall  : 30;
  slew_upper_threshold_pct_rise  : 70;
  slew_upper_threshold_pct_fall  : 70;
  slew_derate_from_library       : 0.5;
  nom_process                    : 1;
  nom_temperature                : 125;
  nom_voltage                    : 1.08;

  cell (temp_sensor_block) {
    area : 4156.32000000;
    is_macro_cell : true;
   pin("clk") {
     direction               : input;
     clock                   : true;
     capacitance             : 0.00177283;
                timing () {
                       timing_sense        : positive_unate;
                       timing_type        : min_clock_tree_path;
                        cell_fall(scalar) {
                                values ("0.00000000");
                       }
                        cell_rise(scalar) {
                                values ("0.00000000");
                       }
                }
                timing () {
                       timing_sense        : positive_unate;
                       timing_type        : max_clock_tree_path;
                        cell_fall(scalar) {
                                values ("0.00000000");
                       }
                        cell_rise(scalar) {
                                values ("0.00000000");
                       }
                }
   }
   pin("os_int_o") {
     direction               : output;
     capacitance             : 0.00000000;
   }
   pin("os_int_oe") {
     direction               : output;
     capacitance             : 0.00000000;
   }
   pin("rstn") {
     direction               : input;
     capacitance             : 0.17905752;
   }
   pin("scl_i") {
     direction               : input;
     capacitance             : 0.00081541;
   }
   pin("sda_i") {
     direction               : input;
     capacitance             : 0.00080473;
   }
   pin("sda_o") {
     direction               : output;
     capacitance             : 0.00000000;
   }
   pin("sda_oe") {
     direction               : output;
     capacitance             : 0.00088293;
   }
   pin("t2f_in") {
     direction               : input;
     capacitance             : 0.00147740;
   }
  }
}
